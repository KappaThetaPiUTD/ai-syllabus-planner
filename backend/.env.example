# Copy this file to .env and fill in the values.

# Secret used to sign login tokens. Change this to any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Database. SQLite works out of the box. For PostgreSQL/Supabase use e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./syllabus.db

# Where the frontend runs (used for CORS and for redirecting after Google sign-in)
FRONTEND_URL=http://localhost:3000

# ---- AI (all free) ----
# Google Gemini: free key at https://aistudio.google.com -> "Get API key". Reads PDFs directly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Groq (optional backup, used if Gemini fails or hits its daily limit):
# free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# With no keys at all, the built-in rule-based date extractor is used.
# (Optional, paid) Claude: ANTHROPIC_API_KEY=

# Google Calendar OAuth (see README "Google Calendar setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# Timezone used for events sent to Google Calendar
DEFAULT_TIMEZONE=America/Chicago
